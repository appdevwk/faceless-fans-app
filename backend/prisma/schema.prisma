generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  posts     Post[]
  fans      Fan[]    @relation("FanCreator", references: [id])
  creators  Fan[]    @relation("CreatorFan", references: [id])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  mediaUrl  String
  priceUsd  Int
  caption   String?
  creator   User     @relation(fields: [creatorId], references: [id])
  creatorId String
  createdAt DateTime @default(now())
  fans      Fan[]
}

model Fan {
  id         String   @id @default(cuid())
  user       User     @relation("FanCreator", fields: [userId], references: [id])
  userId     String
  creator    User     @relation("CreatorFan", fields: [creatorId], references: [id])
  creatorId  String
  subscribed Boolean  @default(false)
  stripeSub  String?
  createdAt  DateTime @default(now())
}
